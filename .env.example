# Electrum-protocol server (Electrs / Fulcrum / ElectrumX)
ELECTRUM_HOST=electrum.example.local
ELECTRUM_PORT=50002
ELECTRUM_USE_SSL=true

# Portfolio base currency (CHF, EUR, or USD)
BASE_CURRENCY=CHF

# Default gap-limit when scanning xpub chains
GAP_LIMIT=20

# Where the SQLite DB lives inside the container
BTCTRACK_DB_PATH=/app/data/btctrack.db
